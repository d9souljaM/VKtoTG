# Токен Telegram-бота от @BotFather
TG_TOKEN=

# Ключ доступа сообщества VK: «Управление» → «Работа с API» → «Ключи доступа».
# Права: управление сообществом, сообщения сообщества, фотографии, документы.
VK_TOKEN=

# --- Необязательные настройки ---

# Ваш Telegram ID: владельцу бота доступна команда /update — обновление из GitHub кнопкой.
# Узнать ID: напишите боту /start в личные сообщения, пока TG_OWNER_ID не задан.
# TG_OWNER_ID=

# Прокси для Telegram, если он доступен только через VPN: адрес локального прокси VPN-клиента.
# Через прокси идёт только Telegram, VK подключается напрямую. Поддерживаются http:// и socks5://.
# TG_PROXY=http://127.0.0.1:12334

# ID сообщества. По умолчанию определяется по токену.
# VK_GROUP_ID=

# При запуске включать в сообществе сообщения, возможности ботов и Long Poll API (1/0).
# VK_AUTO_SETUP=1

# Путь к базе SQLite.
# DB_PATH=bridge.db

# DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# inline — «Имя: текст», newline — имя и текст на разных строках.
# MESSAGE_FORMAT=inline

# Максимальный размер файла из Telegram в VK (Bot API отдаёт до 20 МБ).
# TG_DOWNLOAD_LIMIT_MB=20

# Максимальный размер файла из VK в Telegram (Bot API принимает до 50 МБ).
# TG_UPLOAD_LIMIT_MB=50

# Сколько дней хранить соответствие сообщений (нужно для ответов и правок).
# MAPPING_TTL_DAYS=30
